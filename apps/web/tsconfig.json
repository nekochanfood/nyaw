{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@/*": ["./src/*"],
      "@locale/*": ["./locale/*"],
      "@assets/*": ["../../assets/*"]
    },
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "vite.config.ts",
    "vitest.config.ts",
    "alias.ts",
    "playwright.config.ts",
    "e2e"
  ]
}
